<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lixel_ros</name>
  <!-- 与 SDK 版本一致（唯一来源 include/xg/robot_sdk_c.h 的 XG_SDK_VERSION_*），
       不一致时 CMakeLists.txt 配置阶段报错 -->
  <version>1.1.0</version>
  <description>XGRIDS lixel_ros ROS2 bridge: 将设备数据桥接为标准 ROS2 Topic</description>
  <maintainer email="embedded@xgrids.com">XGRIDS Embedded Software Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>diagnostic_msgs</depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
